# Copy to .env and replace every placeholder. Never commit .env.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional locally. Vercel Neon injects the direct URL under this name.
# When it is unset, scripts copy DATABASE_URL into it.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string
CLIENT_URL=http://localhost:5173
PORT=4000
NODE_ENV=development

# Optional. Production boots run migrations unless this is false.
# RUN_MIGRATIONS=true
# MIGRATE_TIMEOUT_MS=60000
